{
  "metadata": {
    "name": "Enterprise Environment",
    "description": "Corporate/business environment with functional departments, weekday-concentrated business-hours traffic.",
    "base_scenario": "enterprise",
    "version": "1.0"
  },
  "observation_period": {
    "start_datetime": "2026-01-05T00:00:00",
    "end_datetime": "2026-01-12T00:00:00",
    "duration_preset": "one_week",
    "timezone": "America/New_York",
    "granularity": "second",
    "include_holidays": true,
    "holiday_calendar": "US"
  },
  "communication_scale": {
    "num_users": 2000,
    "num_communication_sessions": "derived",
    "avg_calls_per_user_per_day": 11,
    "max_calls_per_user_per_day": 40,
    "active_user_percentage": 0.78,
    "frequent_callers_per_user": { "min": 4, "max": 15 },
    "pairwise_frequency_model": { "distribution": "zipfian", "zipf_exponent": 1.2 },
    "inactive_user_behavior": "minimal_calls"
  },
  "traffic_distribution": {
    "peak_hours": [
      { "start": 9, "end": 11, "weight_multiplier": 2.2 },
      { "start": 14, "end": 16, "weight_multiplier": 2.0 }
    ],
    "off_peak_hours": [
      { "start": 0, "end": 7, "weight_multiplier": 0.05 },
      { "start": 19, "end": 23, "weight_multiplier": 0.15 }
    ],
    "weekday_weekend_ratio": 6.5,
    "daily_weight_profile": [1.0, 1.05, 1.05, 1.0, 0.9, 0.1, 0.05],
    "burst_periods": [
      { "trigger": "month_end_reporting", "start": "last_2_business_days", "end": "month_end", "multiplier": 1.6, "probability": 0.7 }
    ],
    "intraday_curve_shape": "bimodal"
  },
  "call_outcome_distribution": {
    "answered_probability": 0.85,
    "busy_probability": 0.035,
    "no_answer_probability": 0.08,
    "rejected_probability": 0.02,
    "failed_probability": 0.015,
    "outcome_by_category": {
      "external_client": { "answered_probability": 0.78, "busy_probability": 0.04, "no_answer_probability": 0.12, "rejected_probability": 0.03, "failed_probability": 0.03 }
    }
  },
  "organizational_structure": {
    "structure_type": "hierarchical",
    "departments": [
      { "id": "sales", "name": "Sales", "size": 300, "communication_affinity": 0.6 },
      { "id": "engineering", "name": "Engineering", "size": 600, "communication_affinity": 0.75 },
      { "id": "hr", "name": "Human Resources", "size": 80, "communication_affinity": 0.5 },
      { "id": "finance", "name": "Finance", "size": 120, "communication_affinity": 0.55 },
      { "id": "it", "name": "IT", "size": 150, "communication_affinity": 0.65 },
      { "id": "operations", "name": "Operations", "size": 400, "communication_affinity": 0.6 },
      { "id": "exec", "name": "Executive", "size": 30, "communication_affinity": 0.4 },
      { "id": "admin", "name": "Administrative Support", "size": 320, "communication_affinity": 0.5 }
    ],
    "roles": [
      { "id": "ceo", "name": "CEO", "department": "exec", "seniority_level": "executive", "call_privilege_tier": "unrestricted" },
      { "id": "manager", "name": "Department Manager", "department": "*", "seniority_level": "management", "call_privilege_tier": "unrestricted" },
      { "id": "employee", "name": "Employee", "department": "*", "seniority_level": "staff", "call_privilege_tier": "standard" }
    ],
    "reporting_lines": [],
    "intra_department_call_ratio": 0.68,
    "shift_pattern": null
  },
  "network_configuration": {
    "internal_ip_ranges": ["10.10.0.0/16", "10.20.0.0/16"],
    "external_ip_ranges": ["0.0.0.0/0"],
    "nat_enabled": true,
    "network_segments": [
      { "segment_id": "seg-eng", "cidr": "10.10.10.0/24", "department_ids": ["engineering"], "vlan_id": 110 },
      { "segment_id": "seg-sales", "cidr": "10.10.20.0/24", "department_ids": ["sales"], "vlan_id": 120 },
      { "segment_id": "seg-corp", "cidr": "10.10.30.0/24", "department_ids": ["hr", "finance", "exec", "admin"], "vlan_id": 130 },
      { "segment_id": "seg-ops", "cidr": "10.10.40.0/24", "department_ids": ["operations", "it"], "vlan_id": 140 }
    ],
    "remote_access_ratio": 0.15
  },
  "protocol_configuration": {
    "signaling_protocols": [
      { "protocol": "SIP", "weight": 0.95 },
      { "protocol": "H.323", "weight": 0.05 }
    ],
    "media_protocols": [
      { "protocol": "RTP", "weight": 0.6 },
      { "protocol": "SRTP", "weight": 0.4 }
    ],
    "sip_port_range": { "min": 5060, "max": 5061 },
    "rtp_port_range": { "min": 16384, "max": 32767 },
    "encryption_ratio": 0.4
  },
  "codec_distribution": {
    "codecs": [
      { "name": "G.711", "weight": 0.55, "bitrate_kbps": 64, "sample_rate_hz": 8000, "typical_use": "internal desk phones" },
      { "name": "G.729", "weight": 0.2, "bitrate_kbps": 8, "sample_rate_hz": 8000, "typical_use": "WAN-constrained links" },
      { "name": "G.722", "weight": 0.1, "bitrate_kbps": 64, "sample_rate_hz": 16000, "typical_use": "HD conference rooms" },
      { "name": "Opus", "weight": 0.15, "bitrate_kbps": 32, "sample_rate_hz": 48000, "typical_use": "softphone/mobile" }
    ]
  }
}
